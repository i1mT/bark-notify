{
  "name": "barkdesk-notify",
  "version": "1.0.1",
  "description": "Cross-platform Bark CLI with a short notify command.",
  "type": "module",
  "bin": {
    "notify": "dist/src/main.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "bark",
    "notification",
    "push",
    "cli",
    "notify"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/i1mT/bark-notify.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/i1mT/bark-notify#readme",
  "bugs": {
    "url": "https://github.com/i1mT/bark-notify/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3"
  }
}
